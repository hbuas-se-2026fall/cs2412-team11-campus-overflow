{
  "info": {
    "name": "CampusOverflow API",
    "description": "Lab 4 端到端验证：注册 → 登录 → 提问 → 列表",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" }
  ],
  "item": [
    {
      "name": "1. 注册",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"student01\",\"displayName\":\"测试同学\",\"email\":\"student01@campus.edu\",\"password\":\"Passw0rd!\",\"college\":\"计算机学院\",\"className\":\"软件2101\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "auth", "register" ]
        },
        "description": "创建测试账号，期望 201 与 {\"id\":1}"
      }
    },
    {
      "name": "2. 登录",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"student01\",\"password\":\"Passw0rd!\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "auth", "login" ]
        },
        "description": "期望 200，Postman 自动保存 JSESSIONID Cookie"
      }
    },
    {
      "name": "3. 发布问题",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\"courseId\":null,\"title\":\"第一个问题\",\"body\":\"这是通过 Postman 创建的第一个问题正文。\",\"tags\":[\"java\",\"spring\"]}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/questions",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "questions" ]
        },
        "description": "提交物 4 的成功用例，期望 201 与 {\"id\":1}"
      }
    },
    {
      "name": "4. 问题列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/questions",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "questions" ]
        },
        "description": "期望 200，content 首条为「第一个问题」"
      }
    }
  ]
}